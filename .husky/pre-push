#!/usr/bin/env sh

if [ "${SKIP_WPORG_PUSH_GUARD:-}" = "1" ] || [ "${TRPL_SKIP_WPORG_DEPLOY:-}" = "1" ]; then
  exit 0
fi

tmp_refs="$(mktemp)"
trap 'rm -f "$tmp_refs"' EXIT
cat >"$tmp_refs"

should_sync=0

while read -r local_ref local_oid remote_ref remote_oid
do
  if [ "$local_ref" = "refs/heads/main" ] || [ "$remote_ref" = "refs/heads/main" ]; then
    should_sync=1
    break
  fi
done <"$tmp_refs"

[ "$should_sync" = "1" ] || exit 0

current_branch="$(git branch --show-current 2>/dev/null)"
[ "$current_branch" = "main" ] || exit 0

version="$(node -p "require('./package.json').version")"
commit_subject="$(git log -1 --pretty=%s)"

printf '\nSyncing WordPress.org SVN before pushing main...\n'

if ! node scripts/release.mjs deploy "Sync ${version}: ${commit_subject}"; then
  printf '\nWordPress.org sync failed, so the push was stopped.\n' >&2
  printf 'If you need to bypass this once, run with `TRPL_SKIP_WPORG_DEPLOY=1 git push origin main`.\n\n' >&2
  exit 1
fi

printf 'WordPress.org SVN is in sync. Continuing push.\n\n'
exit 0
